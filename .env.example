# Clerk secret key — Clerk Dashboard → Configure → API keys → Secret keys
CLERK_SECRET_KEY=

# Name of the JWT template used to mint bearer tokens
# (Clerk Dashboard → Configure → JWT templates)
CLERK_JWT_TEMPLATE=default

# Origin baked into the token's azp (authorized party) claim — set this to the
# origin your API expects. Defaults to http://localhost:5173 when unset.
CLERK_AZP_ORIGIN=http://localhost:5173
